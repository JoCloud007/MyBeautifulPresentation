# Docker Compose Proxy Configuration
# Copy this file to .env and set the values for your environment.
# These variables are used by docker-compose.yml for both build args and runtime environment.

# HTTP proxy for outgoing connections (e.g., http://proxy.company.com:8080)
COMPOSE_HTTP_PROXY=

# HTTPS proxy for outgoing connections (e.g., http://proxy.company.com:8080)
COMPOSE_HTTPS_PROXY=

# Comma-separated list of hosts to bypass the proxy (e.g., localhost,127.0.0.1,.company.com)
COMPOSE_NO_PROXY=

# Set to 0 to disable TLS certificate validation (useful for corporate proxies with self-signed certs)
COMPOSE_NODE_TLS_REJECT_UNAUTHORIZED=1
